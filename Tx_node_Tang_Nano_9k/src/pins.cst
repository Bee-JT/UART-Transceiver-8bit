// 27 MHz System Clock (Bank 2 - 3.3V)
IO_LOC "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Reset Button (Bank 3 - MUST BE 1.8V)
IO_LOC "rst" 3; 
IO_PORT "rst" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// Input FROM your PC (Bank 3 - MUST BE 1.8V)
IO_LOC "pc_rx_pin" 86;
IO_PORT "pc_rx_pin" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// Output TO Team B (Pin 25 - 3.3V)
IO_LOC "b_tx" 25; 
IO_PORT "b_tx" IO_TYPE=LVCMOS33;